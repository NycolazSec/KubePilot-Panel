# Copy to deploy/config.env (git-ignored) — used by ./deploy.sh to build and deploy from source
KUBEPILOT_HOST=panel.example.com        # public domain of the panel (Ingress + TLS)
KUBEPILOT_NODE=                         # node holding the local-path volumes (kubectl get nodes); empty on a single-node cluster
KUBEPILOT_ISSUER=letsencrypt-prod       # cert-manager ClusterIssuer (empty = no certificate annotation)
KUBEPILOT_INGRESS_CLASS=                # empty = default IngressClass (Traefik on k3s)
