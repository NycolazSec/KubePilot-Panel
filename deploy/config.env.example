# Copy to deploy/config.env (git-ignored) — used by ./deploy.sh to build and deploy from source
KUBEPILOT_HOST=panel.example.com        # public domain of the panel (Ingress + TLS)
KUBEPILOT_NODE=                         # node holding the local-path volumes (kubectl get nodes); empty on a single-node cluster
KUBEPILOT_ISSUER=letsencrypt-prod       # cert-manager ClusterIssuer (empty = no certificate annotation)
KUBEPILOT_INGRESS_CLASS=                # empty = default IngressClass (Traefik on k3s)
KUBEPILOT_MINECRAFT_ROUTER=false        # true: deploy mc-router, Minecraft servers get <hostname>.<domain> on port 25565
KUBEPILOT_SFTP_PORT=2022                # SFTP port (pick another one if Pterodactyl Wings already uses 2022)
KUBEPILOT_CLOUDFLARE_ONLY=false         # true when the domain is proxied by Cloudflare: refuse direct hits on the node (Traefik)
# Emails ("forgot your password"): empty host = off. The password goes in the Secret kubepilot-smtp (see deploy.sh).
KUBEPILOT_SMTP_HOST=                    # e.g. smtp-relay.brevo.com
KUBEPILOT_SMTP_PORT=0                   # 0 = default port of the TLS mode
KUBEPILOT_SMTP_TLS=starttls             # starttls | tls | none
KUBEPILOT_SMTP_USERNAME=
KUBEPILOT_MAIL_FROM=                    # e.g. "KubePilot <noreply@example.com>" (quote it)
