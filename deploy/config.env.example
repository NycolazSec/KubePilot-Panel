# Copy to deploy/config.env (git-ignored) and adapt.
KUBEPILOT_HOST=panel.example.com        # public domain of the panel (Ingress + TLS)
KUBEPILOT_NODE=my-node                  # node holding the local-path volumes (kubectl get nodes)
KUBEPILOT_ISSUER=letsencrypt-prod       # cert-manager ClusterIssuer
