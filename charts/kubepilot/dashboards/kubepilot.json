    {
      "id": 15,
      "type": "row",
      "title": "Nodes",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "CPU",
      "description": "vCPU used, and what the node can give.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 8,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "kubepilot_node_cpu_millicores{node=~\"$node\"} / 1000",
          "legendFormat": "{{node}} used",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "kubepilot_node_cpu_capacity_millicores{node=~\"$node\"} / 1000",
          "legendFormat": "{{node}} capacity",
