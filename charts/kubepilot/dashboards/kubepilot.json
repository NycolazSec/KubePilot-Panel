    {
      "id": 6,
      "type": "stat",
      "title": "Nodes ready",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(kubepilot_node_ready) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
